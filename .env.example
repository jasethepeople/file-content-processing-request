# Copy to .env and set permission 0600. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-unique-long-value
HERMES_DATABASE_URL=postgresql+asyncpg://hermes:change-me-to-a-unique-long-value@postgres:5432/hermes
HERMES_REDIS_URL=redis://redis:6379/0
# Inject interactively at boot or through a locked-down secret manager. Do not leave this in shell history.
HERMES_BOOT_PASSPHRASE=
# Required only when config selects Vault.
HERMES_VAULT_TOKEN=
